<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.RemoveEntryController" alignment="CENTER" spacing="15.0">
    <padding>
        <Inserts bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
    <children>
        <Label text = "Remove Entry" style="-fx-front-size: 20px; -fx-front-weight: bold;"/>
        <ComboBox fx:id="removeTypeCombo" promptText="Select Type" maxWidth="Infinity" onAction="#handleTypeSelected"/>
        <ComboBox fx:id="removeEntryCombo" promptText="Select Entry" maxWidth="Infinity"/>
        <Label fx:id="statusLabel" style="-fx-text-fill: RED;"/>
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button text="Remove" onaction="#confirmRemoveEntry"/>
                <Button text="Back" onAction="#goBack"/>
            </children>
        </HBox>
    </children>
</VBox>








