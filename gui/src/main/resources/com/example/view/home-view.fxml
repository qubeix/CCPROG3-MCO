<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox fx:id="homePanel" fx:controller="com.example.controller.HomeController" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      spacing="18.0" alignment="TOP_CENTER" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 10;"
      AnchorPane.topAnchor="35.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

    <padding>
        <Insets top="30" left="25" right="25" bottom="20"/>
    </padding>

    <children>
        <Label fx:id="dateLabel" style="-fx-font-size: 20px; -fx-text-fill: #224aa6;">
            <font><Font name="Century Gothic Bold" size="20.0"/></font>
        </Label>

        <Label fx:id="timeLabel" style="-fx-font-size: 32px; -fx-text-fill: #224aa6;">
            <font><Font name="Century Gothic Bold" size="32.0"/></font>
        </Label>

        <Separator/>

        <Label text="Library Completion" style="-fx-font-size: 14px; -fx-font-weight: bold;">
            <font><Font name="Century Gothic Bold" size="14.0"/></font>
        </Label>

        <ProgressBar fx:id="completionBar" prefWidth="400.0" prefHeight="20.0"/>

        <Label fx:id="completionLabel" style="-fx-font-size: 13px;">
            <font><Font name="Century Gothic" size="13.0"/></font>
        </Label>
    </children>
</VBox>