<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.model.NumberTextField?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- Add Book Entry -->
<VBox fx:id="addBookPanel"
      spacing="12.0"
      alignment="TOP_LEFT"
      visible="false"
      managed="false"
      style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 10;"
      AnchorPane.topAnchor="35.0"
      AnchorPane.leftAnchor="10.0"
      AnchorPane.rightAnchor="10.0"
      AnchorPane.bottomAnchor="10.0">

    <padding>
        <Insets top="20" left="25" right="25" bottom="20"/>
    </padding>

    <children>
        <Label text="Add Book" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #224aa6;"/>

        <TextField fx:id="bookTitleField" promptText="Book Title"
                   style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6;"/>

        <TextField fx:id="bookAuthorField" promptText="Author"
                   style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6;"/>

        <Label text="Genre:" style="-fx-font-weight: bold;"/>

        <HBox spacing="10.0">
            <children>
                <RadioButton fx:id="romanceButton" text="Romance" style="-fx-mark-color: #224aa6">
                    <toggleGroup><ToggleGroup fx:id="bookGenreGroup"/></toggleGroup>
                </RadioButton>
                <RadioButton fx:id="mysteryButton" text="Mystery" toggleGroup="$bookGenreGroup" style="-fx-mark-color: #224aa6"/>
                <RadioButton fx:id="fantasyButton" text="Fantasy" toggleGroup="$bookGenreGroup" style="-fx-mark-color: #224aa6"/>
                <RadioButton fx:id="nonfictionButton" text="Non-Fiction" toggleGroup="$bookGenreGroup" style="-fx-mark-color: #224aa6"/>
                <RadioButton fx:id="selfhelpButton" text="Self-Help" toggleGroup="$bookGenreGroup" style="-fx-mark-color: #224aa6"/>
            </children>
        </HBox>

        <NumberTextField fx:id="bookChapter" promptText="Number of Chapters"
                         style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6;"/>

        <HBox spacing="10.0">
            <children>
                <Button text="Submit"
                        onAction="#confirmAddBook"
                        style="-fx-background-color: #448afa; -fx-text-fill: white; -fx-background-radius: 5;"/>
                <Button text="Clear"
                        onAction="#clearAddBook"
                        style="-fx-background-color: #f6933c; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </children>
        </HBox>

        <Label fx:id="bookErrorLabel" style="-fx-text-fill: RED">
            <font><Font name="Century Gothic Bold" size="13.0"/></font>
        </Label>

        <TextArea fx:id="outputArea" editable="false" wrapText="true"
                  style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6;"/>
    </children>
</VBox>



