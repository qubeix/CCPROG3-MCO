<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.MainMenuController">
   <top>
      <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #ADD8E6;">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Welcome!" />
         </children>
      </VBox>
   </top>
   <left>
      <VBox spacing="10.0" alignment="TOP_CENTER" prefWidth="180.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
         </padding>
         <children>
            <Label text="Add Entry" style="-fx-font-weight: bold"/>
            <Button fx:id="addBookButton" text="Add Book" maxWidth="Infinity" onAction="#handleAddBook"/>
            <Button fx:id="addAlbumButton" text="Add Album" maxWidth="Infinity" onAction="#handleAddAlbum"/>
            <Button fx:id="addSeriesButton" text="Add Series" maxWidth="Infinity" onAction="#handleAddSeries" />

            <Separator/>

            <Label text="Manage" style="-fx-font-weight: bold;" />
            <Button fx:id="removeEntryButton" text="Remove Entry" maxWidth="Infinity" onAction="#handleRemoveEntry"/>
            <Button fx:id="rateEntryButton" text="Rate Entry" maxWidth="Infinity" onAction="#handleRateEntry"/>
            <Button fx:id="reviewEntryButton" text="Review Entry" maxWidth="Infinity" onAction="#handleReviewEntry"/>
            <Button fx:id="updateProgressButton" text="Update Progress" maxWidth="Infinity" onAction="#handleUpdateProgress"/>

            <Separator/>

            <Label text="View" style="-fx-font-weight: bold;" />
            <Button fx:id="viewAllButton" text="View All Entries" maxWidth="Infinity" onAction="#handleViewAll"/>
            <Button fx:id="viewSummaryButton" text="View Summary" maxWidth="Infinity" onAction="#handleViewSummary"/>

            <Separator/>

            <Button fx:id="logoutButton" text="Log Out" maxWidth="Infinity" onAction="#handleLogout"/>
         </children>
      </VBox>
   </left>
   <center>
      <VBox spacing="8.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
         </padding>
         <children>
            <Label text="Output" style="-fx-font-weight: bold"/>
            <TextArea fx:id="outputArea" editable="false" wrapText="true" prefHeight="400.0" VBox.vgrow="ALWAYS"/>
         </children>
      </VBox>
   </center>
</BorderPane>