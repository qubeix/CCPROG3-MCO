<?xml version="1.0" encoding="UTF-8"?>

<?import com.example.model.NumberTextField?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox fx:id="updateEntryPanel" fx:controller="com.example.controller.UpdateProgressController" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" spacing="12.0" alignment="TOP_LEFT" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 10;"
      AnchorPane.topAnchor="35.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">

    <padding>
        <Insets top="20" left="25" right="25" bottom="20"/>
    </padding>

    <children>
        <Label text="Update Progress" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #224aa6;">
            <font>
                <Font name="Century Gothic Bold" size="16.0"/>
            </font>
        </Label>

        <ComboBox fx:id="updateTypeCombo" promptText="Select Type" maxWidth="Infinity" onAction="#onUpdateTypeSelected" style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-font-family: 'Century Gothic';"/>

        <ComboBox fx:id="updateEntryCombo" promptText="Select Entry" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-font-family: 'Century Gothic';"/>

        <HBox spacing="10.0">
            <children>
                <Button text="Update Progress" onAction="#confirmUpdateEntry" style="-fx-background-color: #448afa; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-family: 'Century Gothic Bold';"/>
                <Button text="Clear" onAction="#clearUpdateEntry" style="-fx-background-color: #f6933c; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-family: 'Century Gothic Bold';"/>
            </children>
        </HBox>

        <Label fx:id="updateEntryMessage" style="-fx-text-fill: RED">
            <font>
                <Font name="Century Gothic Bold" size="16.0"/>
            </font>
        </Label>
    </children>
</VBox>