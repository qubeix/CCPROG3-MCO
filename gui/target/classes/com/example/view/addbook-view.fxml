<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.example.model.NumberTextField?>

<fx:root type="javafx.scene.layout.StackPane" xmlns:fx="http://javafx.com/fxml/1">
   <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ADD8E6">
      <children>
         <Label text="ADD BOOK" />
         <TextField fx:id="bookTitle" promptText="Title" prefWidth="100.0" maxWidth="100.0"/>
         <TextField fx:id="bookAuthor" promptText="Author" prefWidth="100.0" maxWidth="100.0"/>
         <HBox alignment="CENTER" spacing="15.0">
         <fx:define>
               <ToggleGroup fx:id="genreGroup"/>
         </fx:define>
         <children>
               <RadioButton id="romanceButton" text="Romance" toggleGroup="$genreGroup"/>
               <RadioButton id="mysteryButton" text="Mystery" toggleGroup="$genreGroup"/>
               <RadioButton id="fantasyButton" text="Fantasy" toggleGroup="$genreGroup"/>
               <RadioButton id="nonfictionButton" text="Non-Fiction" toggleGroup="$genreGroup"/>
               <RadioButton id="selfhelpButton" text="Self-Help" toggleGroup="$genreGroup"/>
         </children>
         </HBox>
         <NumberTextField fx:id="bookChapters" promptText="Number of Chapters" prefWidth="75.0" maxWidth="75.0"/>
         <Button fx:id="submitBookButton" text="Add Book" onAction="#submitBook"/>
      </children>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
   </VBox>
</fx:root>
