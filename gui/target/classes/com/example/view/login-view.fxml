<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.CheckBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.LoginController">
   <children>
      <Label text="LOG IN"/>
      <TextField fx:id="usernameField" promptText="Username:" prefWidth="200.0" maxWidth="200.0"/>
      <PasswordField fx:id="passwordField" promptText="Password:" prefWidth="200.0" maxWidth="200.0"/>
      <TextField fx:id="passwordVisibleField" promptText="Password:" visible="false" managed="false" prefWidth="200.0" maxWidth="200.0"/>
      <CheckBox fx:id="showPasswordCheckBox" text="Show Password" onAction="#toggleShowPassword"/>
      <Button fx:id="verifyLoginButton" text="Log In" onAction="#verifyLogin"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
