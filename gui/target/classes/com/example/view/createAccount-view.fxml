<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.CreateAccountController">
    <children>
        <Label text="CREATE ACCOUNT"/>
        <TextField fx:id="nameField" promptText="Name: " prefWidth="200.0" maxWidth="200.0"/>
        <TextField fx:id="usernameField" promptText="Username: " prefWidth="200.0" maxWidth="200.0"/>
        <TextField fx:id="passwordField" promptText="Password: " prefWidth="200.0" maxWidth="200.0"/>
        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="createButton" text="Create Account" onAction="#createAccount"/>
                <Button fx:id="backButton" text="Back" onAction="#goBack"/>
            </children>
        </HBox>
        <Label fx:id="errorLabel" textFill="RED" text=""/>
    </children>
    <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
